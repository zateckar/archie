# Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Admin Password (default: admin)
ADMIN_PASSWORD=admin

# Database Path (default: rag.db)
DATABASE_PATH=data/rag.db

# OIDC Configuration (Optional)
# OIDC_ISSUER=https://your-oidc-provider.com/realms/your-realm
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# PUBLIC_URL=http://localhost:5173


# ── Model Configuration ─────────────────────────────────────────────────────
# The app supports two model providers for text, embedding, and reranking:
#
#   PRIMARY  : a custom OpenAI-compatible LiteLLM gateway (the LLM_* vars below).
#              Used automatically whenever LLM_BASE_URL and LLM_API_KEY are set.
#   FALLBACK : Google Gemini (the GEMINI_API_KEY + *_MODEL vars below). Used when
#              the LiteLLM gateway is not configured, or transparently on any
#              LiteLLM error so a gateway outage degrades to Gemini instead of
#              failing the request.
#
# Leave the LLM_* vars empty to run on Gemini only.

# Gemini (fallback) model ids
TEXT_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-2
RERANK_MODEL=gemini-3-flash-preview
CHUNK_MODEL=gemini-3-flash-preview

# LiteLLM (primary) — OpenAI-compatible gateway
# Base URL exposing /chat/completions, /embeddings, and /rerank
LLM_BASE_URL=
# Bearer token for the gateway
LLM_API_KEY=
# Model name for /chat/completions (text generation + chat)
LLM_TEXT_MODEL=
# Model name for /embeddings
LLM_EMBEDDING_MODEL=
# Model name for /rerank (native cross-encoder reranker).
LLM_RERANK_MODEL=
# The native /rerank endpoint is OPT-IN and OFF by default (some gateway
# rerankers return inverted/nonsensical scores that hurt retrieval). When off,
# reranking uses the text model to rank results (LLM-as-reranker). Set to true
# only after verifying the gateway reranker produces correct ordering.
LLM_RERANK_ENABLED=false
# Per-request timeout (ms) for gateway calls. Default 125000 — just above the
# gateway's observed ~120s hard cap so its real error/body surfaces in logs.
LLM_TIMEOUT_MS=125000
# Max chars per section for slow whole-text tasks (document cleaning, semantic
# chunking) when the LiteLLM gateway is primary. Large sections (80K) time out on
# a slow gateway; the default 6000 finishes comfortably. Gemini ignores this and
# keeps its large section size. Raise only if your gateway is fast.
LLM_SECTION_MAX_CHARS=6000

# ── IMPORTANT: switching embedding models ───────────────────────────────────
# Query and stored vectors MUST come from the same embedding model. If you point
# LLM_EMBEDDING_MODEL at a model whose vector dimension differs from what's
# already stored in the DB (e.g. Gemini's 3072-dim vs a 4096-dim gateway model),
# vector search silently returns nothing until the corpus is rebuilt.
#
# This now happens AUTOMATICALLY: on server startup the app probes the configured
# embedding model's dimension, compares it to the stored corpus, and re-embeds
# everything if they differ (before any search locks the index to the stale
# size). Matching dimensions are a no-op, so normal restarts stay fast.
#
# To disable automatic migration (e.g. to control when a large re-embed runs)
# set AUTO_REEMBED=false and run it manually instead:
#     npm run reembed
# AUTO_REEMBED=true
#
# Optional: override the fallback dimension used only to initialise an EMPTY
# vector index (real dimension is always detected from actual embeddings):
# EMBEDDING_DIMENSION=4096

# ── Vector search: TurboQuant quantization ──────────────────────────────────
# Vector searches use sqlite-vector's 4-bit TurboQuant index (vector_quantize_scan)
# instead of an exact brute-force scan of every embedding. Measured on a
# 3072-dim corpus with scripts/eval/quantization.ts: recall@10 96.7–97.5%,
# recall@20 97.6–98.4%, the exact top hit preserved on 100% of queries, and
# 1.8–3.2× faster — with the margin widening as the corpus grows.
#
# A table whose embeddings changed since its last quantize automatically reverts
# to the exact scan until the structure is rebuilt (debounced), so ingestion never
# makes fresh data unfindable. Rebuilds are logged as [VectorIndex].
#
# Set to `off` to always use exact search.
# VECTOR_QUANTIZATION=on
#
# TurboQuant precision: 4 (default) or 2. Measured on this corpus, 2 bits drops
# recall@20 to ~93% for ~2× more speed; 3 has no SIMD path in sqlite-vector 1.0.0
# and measured SLOWER than exact search, so it is not a useful setting.
# VECTOR_QBITS=4
#
# Tables with fewer embedded rows than this stay on exact search, where the
# latency difference is imperceptible.
# VECTOR_QUANTIZE_MIN_ROWS=512
#
# Memory budget for the quantized structures (the extension's own default is
# 30MB, which a large corpus exceeds). If a rebuild cannot cover every row within
# the budget the table falls back to exact search and logs why, rather than
# searching an index that omits rows.
# VECTOR_QUANTIZE_MAX_MEMORY=256MB
#
# How long embedding writes must be quiet before a rebuild runs (ms). Higher
# values mean fewer rebuilds during a large git sync; searches stay exact and
# correct while waiting.
# VECTOR_REQUANTIZE_DEBOUNCE_MS=3000

# ── Knowledge graph: taxonomy rebuild schedule ──────────────────────────────
# How the topic hierarchy is maintained, and the app's main token-spend knob
# outside of ingestion itself.
#
# Day to day, placement is INCREMENTAL: each newly extracted topic is attached to
# the tree that already exists, one ingestion at a time. Cheap, but strictly
# local — it never revisits an earlier placement, so the hierarchy slowly drifts
# toward whatever order the documents happened to arrive in.
#
# The corrective is a FULL rebuild, which re-derives every parent from the whole
# topic set at once. That sends every topic back to the model in batches, so it is
# the expensive operation and runs on a clock rather than per sync. (It used to run
# after every git sync, including syncs that ingested nothing — on the default
# 1-hour sync_interval that was 24 full rebuilds a day, and by a wide margin the
# largest token line item in the app.)
#
# Gap between automatic full rebuilds, in ms. Default 604800000 (7 days).
# The schedule is only consulted on a sync that actually changed the corpus, so an
# idle repo costs nothing regardless of how overdue a rebuild is.
# Set to 0 to DISABLE automatic rebuilds; the admin UI trigger still works
# (POST /api/knowledge {"action":"rebuild-taxonomy"}).
#
# This is the DEFAULT, not the last word: an admin can change the cadence at
# Admin → Knowledge graph → Hierarchy, and that setting (stored in the app_state
# table) takes precedence over this variable. The panel says which one is in force,
# so a value here that appears to have no effect has been overridden in the UI.
# Values set through the UI are floored at 1 hour; a value set here is not.
# TAXONOMY_FULL_REBUILD_INTERVAL_MS=604800000

# ── Agent access: the MCP server ────────────────────────────────────────────
# The chat is also exposed over Model Context Protocol at POST /api/mcp, so an MCP
# client (Claude Code, Claude Desktop, Copilot …) can ask the knowledge base and
# manage its own conversations.
#
# Authorization is standard OAuth 2.1 with the OIDC provider configured above as
# the authorization server: the client discovers it from
# /.well-known/oauth-protected-resource/api/mcp, sends the user through the same
# login the web UI uses, and presents the resulting access token. Nothing below
# has to be set for that to work — but two things must be true on the PROVIDER:
#
#   1. Tokens issued for this server carry an audience Archie accepts. A provider
#      that honours RFC 8707 resource indicators stamps the resource URI itself
#      (<PUBLIC_URL>/api/mcp) and needs no configuration. Keycloak more often needs
#      an audience mapper — set MCP_OAUTH_AUDIENCE to whatever that mapper emits.
#   2. MCP clients can obtain a client id: either dynamic client registration
#      (RFC 7591) is enabled, or a public client is pre-registered (authorization
#      code + PKCE, loopback redirect URI) and users are given its id.
#
# /settings reports both live, including whether the provider is reachable.

# Audience values a token may carry, comma-separated. Defaults to the resource URI
# <PUBLIC_URL>/api/mcp. There is deliberately no "accept anything" value: the
# audience check is what stops a token that another service behind the same IdP
# obtained for itself from opening this one.
# MCP_OAUTH_AUDIENCE=archie-mcp

# Scope(s) a token must carry to use MCP at all. Empty means any valid token for
# this audience is enough. A token missing them gets 403 insufficient_scope.
# MCP_OAUTH_REQUIRED_SCOPE=mcp:access

# Force RFC 7662 introspection instead of verifying JWT signatures offline. Slower
# (one call to the provider per token, cached for 60s) but revocation takes effect
# immediately. Opaque, non-JWT tokens always use introspection regardless, which
# needs OIDC_CLIENT_SECRET.
# MCP_OAUTH_INTROSPECT=false

# ── LeanIX: read-only portfolio datasource ──────────────────────────────────
# Pulls tagged factsheets from LeanIX once a day into the knowledge base and the
# /leanix portfolio page. The integration is READ-ONLY by construction: the
# client refuses to send any GraphQL document containing a mutation.
#
# Requests are the scarce resource here, so the sync is built around spending as
# few as possible. A day on which nothing changed costs TWO: one token request,
# and one probe query returning only id/updatedAt for the tagged set. Only if the
# probe shows a change does it spend the two full per-type queries. Nothing else
# in the app ever calls LeanIX — the portfolio page and chat read SQLite.
#
# Leave these empty to disable the datasource entirely.

# OAuth2 client-credentials token endpoint.
# LEANIX_TOKEN_URL=https://app.leanix.net/services/mtm/v1/oauth2/token
# Base64 of "apitoken:<your-api-token>", sent as `Authorization: Basic <this>`.
# LEANIX_TOKEN_CREDENTIALS=
# GraphQL API base; the client appends /graphql.
# LEANIX_API_URL=https://your-gateway.example.com/leanix-pathfinder-jwt/v5
# Extra header an API gateway may require (e.g. Azure APIM subscription key).
# LEANIX_API_EXTRA_HEADER_KEY=Ocp-Apim-Subscription-Key
# LEANIX_API_EXTRA_HEADER_VALUE=

# Which tag to sync, BY ID. Configured as an id rather than a name because
# resolving a name needs an `allTags` query returning the workspace's entire tag
# list, and paying that on every boot defeats the request budget above. To find
# another tag's id, run this query once by hand:
#     { allTags { edges { node { id name tagGroup { name } } } } }
# Default: "Enterprise" in the "SKODA Strategic IT Product" group.
# LEANIX_TAG_ID=f041d49a-8692-44bb-8be1-d752b3514c0b

# Factsheet types to sync. Each one also needs a field selection in
# FACTSHEET_QUERIES (lib/server/leanix.ts) — the types do not share fields.
# LEANIX_FACTSHEET_TYPES=ITComponent,Application

# How often to sync. Default 86400000 (24h).
# LEANIX_SYNC_INTERVAL_MS=86400000

# How often to fetch everything regardless of the change probe, in days.
# Needed because renaming a RELATED factsheet (a provider, say) does not bump
# `updatedAt` on the factsheets pointing at it, so change detection alone would
# let the local copy drift. Default 7.
# LEANIX_FULL_REFRESH_DAYS=7

# Per-request timeout in ms. Default 120000 — the ITComponent query returns
# several thousand relation edges.
# LEANIX_REQUEST_TIMEOUT_MS=120000

# Browsable workspace URL, the base of every "open in LeanIX" link.
#
# Normally leave this unset: it is DERIVED FROM THE ACCESS TOKEN, which carries
# both halves — `instanceUrl` (the regional host; note this is NOT the API
# gateway address in LEANIX_API_URL, which no browser can open) and
# `principal.permission.workspaceName`. The first sync stores the result, giving
# links like
#     https://vwgroup.leanix.net/Volkswagen/factsheet/ITComponent/<id>
# at no extra request cost.
#
# Set this only to override that — e.g. a deployment whose users reach LeanIX
# through a different address. Until either the override or a first sync
# provides one, links are omitted rather than guessed into 404s.
# LEANIX_WORKSPACE_URL=https://vwgroup.leanix.net/Volkswagen

# ── Rate limits ─────────────────────────────────────────────────────────────
# Answered questions per user per minute, counted across the web UI and MCP
# together — one user, one budget, whichever door they came through. Each answer
# fans out to a dozen-plus provider calls, so this is the limit that bounds spend.
# CHAT_RATE_LIMIT_PER_MIN=20

# MCP requests per user per minute. Only guards the cheap read tools against a
# looping agent; `ask` is bounded by CHAT_RATE_LIMIT_PER_MIN above, which is where
# the provider cost actually is. No real client sequence approaches the default.
# MCP_RATE_LIMIT_PER_MIN=120

# ── Market research (web search over the LeanIX portfolio) ──────────────────
# Searches the open web for each portfolio PRODUCT and writes back an assessment
# plus any risk events found. Results appear on /leanix.
#
# Requires GEMINI_API_KEY: web search is the one capability the LiteLLM gateway
# does not provide, and there is deliberately no fallback — answering from model
# memory when search is unavailable would produce confident, uncited, stale
# claims that read exactly like grounded ones.
#
# Only the product's PUBLIC identity (name, alias, vendor, category) is ever sent
# to a search engine. The call that reads the internal record — criticality,
# ownership, dependency counts — runs with no search tool attached, so nothing it
# reads can become a query. See lib/server/market-format.ts.
# MARKET_RESEARCH_ENABLED=false

# How long an assessment stays fresh. This is the main cost dial: each refresh is
# billed twice over, once per grounded search and again per token. A rename or a
# changed vendor invalidates an assessment immediately regardless of this, since
# that is a different product; every other edit does not, because none of them
# change what a search would return.
# MARKET_RESEARCH_TTL_DAYS=7

# Factsheets researched per run — the ceiling on what a single run can spend. A
# first pass over 78 factsheets therefore spreads over about a week rather than
# arriving in one burst, so a misconfiguration costs ten calls to discover
# instead of a hundred and fifty. The admin card reports how many are still
# queued so a partly-filled page never reads as a finished one.
# MARKET_RESEARCH_BATCH=10

# How often a run may start. Guarded hourly, so a container that restarts several
# times a day still researches once.
# MARKET_RESEARCH_INTERVAL_HOURS=24

# How soon a failed attempt is retried. Short enough that a transient provider
# error does not cost a week of silence, long enough that it cannot loop.
# MARKET_RESEARCH_ERROR_RETRY_HOURS=6
