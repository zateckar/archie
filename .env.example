# Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Admin Password (default: admin)
ADMIN_PASSWORD=admin

# Database Path (default: rag.db)
DATABASE_PATH=data/rag.db

# OIDC Configuration (Optional)
# OIDC_ISSUER=https://your-oidc-provider.com/realms/your-realm
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# PUBLIC_URL=http://localhost:5173


# ── Model Configuration ─────────────────────────────────────────────────────
# The app supports two model providers for text, embedding, and reranking:
#
#   PRIMARY  : a custom OpenAI-compatible LiteLLM gateway (the LLM_* vars below).
#              Used automatically whenever LLM_BASE_URL and LLM_API_KEY are set.
#   FALLBACK : Google Gemini (the GEMINI_API_KEY + *_MODEL vars below). Used when
#              the LiteLLM gateway is not configured, or transparently on any
#              LiteLLM error so a gateway outage degrades to Gemini instead of
#              failing the request.
#
# Leave the LLM_* vars empty to run on Gemini only.

# Gemini (fallback) model ids
TEXT_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-2
RERANK_MODEL=gemini-3-flash-preview
CHUNK_MODEL=gemini-3-flash-preview

# LiteLLM (primary) — OpenAI-compatible gateway
# Base URL exposing /chat/completions, /embeddings, and /rerank
LLM_BASE_URL=
# Bearer token for the gateway
LLM_API_KEY=
# Model name for /chat/completions (text generation + chat)
LLM_TEXT_MODEL=
# Model name for /embeddings
LLM_EMBEDDING_MODEL=
# Model name for /rerank (native cross-encoder reranker).
LLM_RERANK_MODEL=
# The native /rerank endpoint is OPT-IN and OFF by default (some gateway
# rerankers return inverted/nonsensical scores that hurt retrieval). When off,
# reranking uses the text model to rank results (LLM-as-reranker). Set to true
# only after verifying the gateway reranker produces correct ordering.
LLM_RERANK_ENABLED=false

# ── IMPORTANT: switching embedding models ───────────────────────────────────
# Query and stored vectors MUST come from the same embedding model. If you point
# LLM_EMBEDDING_MODEL at a model whose vector dimension differs from what's
# already stored in the DB (e.g. Gemini's 3072-dim vs a 4096-dim gateway model),
# vector search silently returns nothing until the corpus is rebuilt.
#
# This now happens AUTOMATICALLY: on server startup the app probes the configured
# embedding model's dimension, compares it to the stored corpus, and re-embeds
# everything if they differ (before any search locks the index to the stale
# size). Matching dimensions are a no-op, so normal restarts stay fast.
#
# To disable automatic migration (e.g. to control when a large re-embed runs)
# set AUTO_REEMBED=false and run it manually instead:
#     npm run reembed
# AUTO_REEMBED=true
#
# Optional: override the fallback dimension used only to initialise an EMPTY
# vector index (real dimension is always detected from actual embeddings):
# EMBEDDING_DIMENSION=4096
