# Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Admin Password (default: admin)
ADMIN_PASSWORD=admin

# Database Path (default: rag.db)
DATABASE_PATH=data/rag.db

# OIDC Configuration (Optional)
# OIDC_ISSUER=https://your-oidc-provider.com/realms/your-realm
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# PUBLIC_URL=http://localhost:5173


# ── Model Configuration ─────────────────────────────────────────────────────
# The app supports two model providers for text, embedding, and reranking:
#
#   PRIMARY  : a custom OpenAI-compatible LiteLLM gateway (the LLM_* vars below).
#              Used automatically whenever LLM_BASE_URL and LLM_API_KEY are set.
#   FALLBACK : Google Gemini (the GEMINI_API_KEY + *_MODEL vars below). Used when
#              the LiteLLM gateway is not configured, or transparently on any
#              LiteLLM error so a gateway outage degrades to Gemini instead of
#              failing the request.
#
# Leave the LLM_* vars empty to run on Gemini only.

# Gemini (fallback) model ids
TEXT_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-2
RERANK_MODEL=gemini-3-flash-preview
CHUNK_MODEL=gemini-3-flash-preview

# LiteLLM (primary) — OpenAI-compatible gateway
# Base URL exposing /chat/completions, /embeddings, and /rerank
LLM_BASE_URL=
# Bearer token for the gateway
LLM_API_KEY=
# Model name for /chat/completions (text generation + chat)
LLM_TEXT_MODEL=
# Model name for /embeddings
LLM_EMBEDDING_MODEL=
# Model name for /rerank (native cross-encoder reranker).
LLM_RERANK_MODEL=
# The native /rerank endpoint is OPT-IN and OFF by default (some gateway
# rerankers return inverted/nonsensical scores that hurt retrieval). When off,
# reranking uses the text model to rank results (LLM-as-reranker). Set to true
# only after verifying the gateway reranker produces correct ordering.
LLM_RERANK_ENABLED=false
# Per-request timeout (ms) for gateway calls. Default 125000 — just above the
# gateway's observed ~120s hard cap so its real error/body surfaces in logs.
LLM_TIMEOUT_MS=125000
# Max chars per section for slow whole-text tasks (document cleaning, semantic
# chunking) when the LiteLLM gateway is primary. Large sections (80K) time out on
# a slow gateway; the default 6000 finishes comfortably. Gemini ignores this and
# keeps its large section size. Raise only if your gateway is fast.
LLM_SECTION_MAX_CHARS=6000

# ── IMPORTANT: switching embedding models ───────────────────────────────────
# Query and stored vectors MUST come from the same embedding model. If you point
# LLM_EMBEDDING_MODEL at a model whose vector dimension differs from what's
# already stored in the DB (e.g. Gemini's 3072-dim vs a 4096-dim gateway model),
# vector search silently returns nothing until the corpus is rebuilt.
#
# This now happens AUTOMATICALLY: on server startup the app probes the configured
# embedding model's dimension, compares it to the stored corpus, and re-embeds
# everything if they differ (before any search locks the index to the stale
# size). Matching dimensions are a no-op, so normal restarts stay fast.
#
# To disable automatic migration (e.g. to control when a large re-embed runs)
# set AUTO_REEMBED=false and run it manually instead:
#     npm run reembed
# AUTO_REEMBED=true
#
# Optional: override the fallback dimension used only to initialise an EMPTY
# vector index (real dimension is always detected from actual embeddings):
# EMBEDDING_DIMENSION=4096

# ── Vector search: TurboQuant quantization ──────────────────────────────────
# Vector searches use sqlite-vector's 4-bit TurboQuant index (vector_quantize_scan)
# instead of an exact brute-force scan of every embedding. Measured on a
# 3072-dim corpus with scripts/eval/quantization.ts: recall@10 96.7–97.5%,
# recall@20 97.6–98.4%, the exact top hit preserved on 100% of queries, and
# 1.8–3.2× faster — with the margin widening as the corpus grows.
#
# A table whose embeddings changed since its last quantize automatically reverts
# to the exact scan until the structure is rebuilt (debounced), so ingestion never
# makes fresh data unfindable. Rebuilds are logged as [VectorIndex].
#
# Set to `off` to always use exact search.
# VECTOR_QUANTIZATION=on
#
# TurboQuant precision: 4 (default) or 2. Measured on this corpus, 2 bits drops
# recall@20 to ~93% for ~2× more speed; 3 has no SIMD path in sqlite-vector 1.0.0
# and measured SLOWER than exact search, so it is not a useful setting.
# VECTOR_QBITS=4
#
# Tables with fewer embedded rows than this stay on exact search, where the
# latency difference is imperceptible.
# VECTOR_QUANTIZE_MIN_ROWS=512
#
# Memory budget for the quantized structures (the extension's own default is
# 30MB, which a large corpus exceeds). If a rebuild cannot cover every row within
# the budget the table falls back to exact search and logs why, rather than
# searching an index that omits rows.
# VECTOR_QUANTIZE_MAX_MEMORY=256MB
#
# How long embedding writes must be quiet before a rebuild runs (ms). Higher
# values mean fewer rebuilds during a large git sync; searches stay exact and
# correct while waiting.
# VECTOR_REQUANTIZE_DEBOUNCE_MS=3000

# ── Knowledge graph: taxonomy rebuild schedule ──────────────────────────────
# How the topic hierarchy is maintained, and the app's main token-spend knob
# outside of ingestion itself.
#
# Day to day, placement is INCREMENTAL: each newly extracted topic is attached to
# the tree that already exists, one ingestion at a time. Cheap, but strictly
# local — it never revisits an earlier placement, so the hierarchy slowly drifts
# toward whatever order the documents happened to arrive in.
#
# The corrective is a FULL rebuild, which re-derives every parent from the whole
# topic set at once. That sends every topic back to the model in batches, so it is
# the expensive operation and runs on a clock rather than per sync. (It used to run
# after every git sync, including syncs that ingested nothing — on the default
# 1-hour sync_interval that was 24 full rebuilds a day, and by a wide margin the
# largest token line item in the app.)
#
# Gap between automatic full rebuilds, in ms. Default 604800000 (7 days).
# The schedule is only consulted on a sync that actually changed the corpus, so an
# idle repo costs nothing regardless of how overdue a rebuild is.
# Set to 0 to DISABLE automatic rebuilds; the admin UI trigger still works
# (POST /api/knowledge {"action":"rebuild-taxonomy"}).
#
# This is the DEFAULT, not the last word: an admin can change the cadence at
# Admin → Knowledge graph → Hierarchy, and that setting (stored in the app_state
# table) takes precedence over this variable. The panel says which one is in force,
# so a value here that appears to have no effect has been overridden in the UI.
# Values set through the UI are floored at 1 hour; a value set here is not.
# TAXONOMY_FULL_REBUILD_INTERVAL_MS=604800000
